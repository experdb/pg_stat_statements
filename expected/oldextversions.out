--------------------+-----------------+-------------------
 t                  | t               | t
(1 row)

DROP EXTENSION pg_stat_statements;
RESET ROLE;
DROP ROLE regress_pgss_su;
-- eXperDB: 1.12e1 <-> 1.12e2 only rebind the C function; a site view on pg_stat_statements does not block it
CREATE EXTENSION pg_stat_statements;
CREATE VIEW pgss_site AS SELECT queryid, calls, stats_last FROM pg_stat_statements;
GRANT SELECT ON pg_stat_statements TO regress_pgss_mon;
AlTER EXTENSION pg_stat_statements UPDATE TO '1.12e1';
SELECT prosrc FROM pg_proc WHERE oid = 'pg_stat_statements(boolean)'::regprocedure;
