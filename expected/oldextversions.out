DROP EXTENSION pg_stat_statements;
-- eXperDB: definitions kept by pg_upgrade from PostgreSQL 15/16/17 are served by this library:
-- 1.11e2 (50, pg_stat_statements_1_11e2), 1.11e1 (51, pg_stat_statements_1_11), 1.10e2 (45, pg_stat_statements_1_10e2),
-- 1.10e1 (46, pg_stat_statements_1_10) and the 45-column "1.10" of the 1.10e1 package (pg_stat_statements_1_10)
CREATE EXTENSION pg_stat_statements;
SELECT 1 AS x;
 x 
---
 1
(1 row)

CREATE FUNCTION pgss_1_11e2_probe(IN showtext boolean,
    OUT userid oid,
    OUT dbid oid,
    OUT toplevel bool,
    OUT queryid bigint,
    OUT query text,
    OUT plans int8,
    OUT total_plan_time float8,
    OUT min_plan_time float8,
    OUT max_plan_time float8,
    OUT mean_plan_time float8,
    OUT stddev_plan_time float8,
    OUT calls int8,
    OUT total_exec_time float8,
    OUT min_exec_time float8,
    OUT max_exec_time float8,
    OUT mean_exec_time float8,
    OUT stddev_exec_time float8,
    OUT rows int8,
    OUT shared_blks_hit int8,
    OUT shared_blks_read int8,
    OUT shared_blks_dirtied int8,
    OUT shared_blks_written int8,
    OUT local_blks_hit int8,
    OUT local_blks_read int8,
    OUT local_blks_dirtied int8,
    OUT local_blks_written int8,
    OUT temp_blks_read int8,
    OUT temp_blks_written int8,
    OUT shared_blk_read_time float8,
    OUT shared_blk_write_time float8,
    OUT local_blk_read_time float8,
    OUT local_blk_write_time float8,
    OUT temp_blk_read_time float8,
    OUT temp_blk_write_time float8,
    OUT wal_records int8,
    OUT wal_fpi int8,
    OUT wal_bytes numeric,
    OUT jit_functions int8,
    OUT jit_generation_time float8,
    OUT jit_inlining_count int8,
    OUT jit_inlining_time float8,
    OUT jit_optimization_count int8,
    OUT jit_optimization_time float8,
    OUT jit_emission_count int8,
    OUT jit_emission_time float8,
    OUT jit_deform_count int8,
    OUT jit_deform_time float8,
    OUT stats_since timestamp with time zone,
    OUT minmax_stats_since timestamp with time zone,
    OUT stats_last timestamp with time zone
)
RETURNS SETOF record
AS '$libdir/pg_stat_statements', 'pg_stat_statements_1_11e2'
LANGUAGE C STRICT VOLATILE;
SELECT count(*) > 0 AS has_data, count(*) = count(stats_since) AS stats_since_set FROM pgss_1_11e2_probe(true);
 has_data | stats_since_set 
----------+-----------------
 t        | t
(1 row)

